# hermes-web 環境變數設定
# 複製此檔案為 .env 並填入實際值

# 伺服器 IP（供前端 URL 使用，嚴禁寫死 localhost）
SERVER_IP=127.0.0.1

# Hermes API Server（僅供內部呼叫，不可對外暴露）
HERMES_HOST=127.0.0.1
HERMES_PORT=8642

# FastAPI 後端（ Twelve-Factor: 連接埠由環境變數控制）
PORT=8000
FASTAPI_URL=http://127.0.0.1:8000

# ws_chat_bridge WebSocket 連接埠
WS_PORT=8767

# FastAPI CORS 允許的前端來源
FRONTEND_ORIGIN=http://127.0.0.1:5173