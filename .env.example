HERMES_HOST=127.0.0.1
HERMES_PORT=8642
API_KEY=hermes-client-key

# ── 前端專用 (Vite) ────────────────────────────────────────────────
# 部署時改為伺服器 IP 或網域名稱（不含結尾斜線）
# VITE_WS_URL=ws://192.168.1.100:8767
# VITE_API_URL=http://192.168.1.100:8000

# ── 後端專用 (FastAPI) ──────────────────────────────────────────────
# 允許的前端來源（部署時設為實際的 Vite 伺服器 URL）
# FRONTEND_ORIGIN=http://192.168.1.100:5173
